# MongoDB local es el backend predeterminado para desarrollo sin contenedores.
MONGO_MODE=local
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=pokedex

# Atlas requiere activación explícita. Reemplaza todos los valores antes de usarlo.
# MONGO_MODE=atlas
# MONGO_ATLAS_URI=mongodb+srv://cluster.example.mongodb.net/pokedex
# MONGO_ATLAS_USERNAME=reemplazar-usuario-atlas
# MONGO_ATLAS_PASSWORD=reemplazar-contrasena-atlas
# MONGO_ATLAS_OPT_IN=true

# Better Auth solo se configura en el servidor. El secreto debe tener 32
# caracteres como mínimo y BETTER_AUTH_URL debe ser la URL pública exacta.
# BETTER_AUTH_SECRET=reemplazar-con-secreto-aleatorio-de-servidor
# BETTER_AUTH_URL=http://127.0.0.1:3000

# MCP HTTP usa un bearer independiente de 24 caracteres como mínimo. Solo se
# habilita cuando el token y el ID de usuario de Better Auth están presentes.
# MCP_BEARER_TOKEN=reemplazar-con-bearer-aleatorio-mcp
# MCP_SUBJECT=id-usuario-better-auth-para-lectura

# Kimi es opcional. La clave permanece solo en el servidor y nunca es necesaria
# para ejecutar la integración continua.
# KIMI_LIVE_ENABLED=true
# MOONSHOT_API_KEY=reemplazar-con-clave-moonshot
# KIMI_TIMEOUT_MS=60000
# Las fotos necesitan un margen mayor que las solicitudes de solo texto.
# KIMI_VISION_TIMEOUT_MS=30000
